# 로컬 개발용 환경 변수 예시
# 이 파일을 복제하여 .env.local 생성 후 실제 값을 설정하세요

# ============================================
# 로컬 백엔드 서버 사용 시 (서버를 직접 실행할 때)
# ============================================
# VITE_API_URL=http://localhost:3000
# VITE_WS_URL=http://localhost:3000
# VITE_API_MOCKING=false

# ============================================
# 목업 데이터 사용 시 (서버 없이 테스트)
# ============================================
VITE_API_URL=
VITE_WS_URL=
# API 모킹 활성화 (MSW)
# true로 설정 시 실제 API 대신 목 데이터 사용합니다
VITE_API_MOCKING=true

# 앱 이름
VITE_APP_TITLE=또랑
